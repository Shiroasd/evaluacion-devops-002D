{
  "name": "dog-rating-app",
  "version": "1.0.0",
  "description": "Interactive dog rating web application with robust CI/CD, security and testing",
  "main": "index.js",
  "scripts": {
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "npx -y eslint@8.57.0 index.js tests/app.test.js --env browser,node,jest,es2021 --rule \"{\\\"no-undef\\\": \\\"error\\\"}\""
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "collectCoverageFrom": [
      "index.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "clover"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 75,
        "functions": 75,
        "lines": 75,
        "statements": 75
      }
    }
  }
}
